# 站点名称
SITE_NAME=SimpleURL

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 调试模式（开启后开放 /api/docs）
DEBUG=false

# 短码长度
CODE_LENGTH=6
CODE_MIN_LENGTH=3
CODE_MAX_LENGTH=16

# 单 IP 每日创建上限，0 表示不限制
CREATE_DAILY_LIMIT=200

# 数据库连接，默认 SQLite；Postgres 示例：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/simpleurl

# 管理令牌（预留）
ADMIN_TOKEN=
