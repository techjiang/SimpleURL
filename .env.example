# 站点名称
SITE_NAME=SimpleURL

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 调试模式（开启后开放 /api/docs）
DEBUG=false

# 短码长度（自动生成，后台「设置」里也能改）
CODE_LENGTH=4
CODE_MIN_LENGTH=3
CODE_MAX_LENGTH=16
# 随机码是否排除易混字符 0 O 1 l I；自定义短码不受影响
CODE_NO_AMBIGUOUS=true

# 单 IP 每日创建上限，0 表示不限制
CREATE_DAILY_LIMIT=200

# 数据库连接，默认 SQLite；Postgres 示例：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/simpleurl

# 管理令牌：后台登录口令。格式 admin:password 可分别设置，
# 也支持直接填 app.core.crypto 产出的哈希值（$argon2id$... / pbkdf2_sha256$...）
ADMIN_TOKEN=

# 访问令牌：设置后访问短链与统计页需带 ?token=xxx（留空表示公开）
ACCESS_TOKEN=

# 会话签名密钥：不设则复用 ADMIN_TOKEN，建议单独配置以便独立轮换
SECRET_KEY=

# 信任哪些反向代理的 X-Forwarded-For / X-Real-IP，逗号分隔或网段。
# 默认只信任回环；填 * 表示无条件信任（仅限内网全可信环境）
TRUSTED_PROXIES=127.0.0.1,::1

# 后台登录防爆破：单 IP 5 分钟内最多尝试次数，0 不限制
LOGIN_RATE_LIMIT=10

# 后台口令长度下限，启动时低于该值会打警告
MIN_ADMIN_TOKEN_LENGTH=12

# 单次导出 CSV 的最大条数
EXPORT_MAX_ROWS=50000

# ---------- 延迟计数 ----------
# 点击缓冲多久批量落库一次（秒）
CLICK_FLUSH_INTERVAL=5

# ---------- 防洪 ----------
# 单 IP 每分钟跳转上限，0 不限制
REDIRECT_RATE_LIMIT=120
# 单 IP 每日点击上限（按自然日重置），0 不限制
CLICK_DAILY_LIMIT=0

# ---------- 标题 / 密钥 / YOURLS ----------
# 创建时自动获取目标页标题
FETCH_TITLE=true
# 要求 API 请求携带 X-Api-Key
REQUIRE_API_KEY=false
# YOURLS 兼容接口签名（留空则不校验）
YOURLS_TOKEN=

# ---------- 社交平台防洪 ----------
# 总开关。平台策略与拦截页提示语都在后台「防洪 / UA 屏蔽」里改，落库生效，
# 这里只给默认值。
SOCIAL_GUARD=true
# 拦截页提示语
SOCIAL_BLOCK_HINT=该链接暂时无法在此处打开，请点击右上角选择「在浏览器中打开」，或复制链接后重试。
# 微信 / QQ 来源打标记（照常放行并计数），关掉则不再区分来源平台
SOCIAL_TAG_WECHAT=true
SOCIAL_TAG_QQ=true
