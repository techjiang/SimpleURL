# 站点名称
SITE_NAME=SimpleURL

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 调试模式（开启后开放 /api/docs）
DEBUG=false

# 短码长度
CODE_LENGTH=6
CODE_MIN_LENGTH=3
CODE_MAX_LENGTH=16

# 单 IP 每日创建上限，0 表示不限制
CREATE_DAILY_LIMIT=200

# 数据库连接，默认 SQLite；Postgres 示例：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/simpleurl

# 访问模式：public（开放外部可使用）/ admin（仅管理员可使用）/ invite（邀请码可使用）
ACCESS_MODE=public

# 管理密钥：设置后即可登录管理；admin / invite 模式下必填
# 生成一个强密钥：openssl rand -hex 24
ADMIN_TOKEN=

# 会话签名密钥：与 ADMIN_TOKEN 无关，改了等于全站重新登录。
# 生产环境务必显式设置一个稳定值，否则每次重启都会重新生成，重启即踢下线。
# 生成：openssl rand -hex 32
SECRET_KEY=

# CSP 只上报不拦截：上线初期用它观察会不会误伤，稳定后再关掉
CSP_REPORT_ONLY=false

# 可信反代地址（逗号分隔）。只有列表内的直连来源，其 X-Forwarded-For 才被采信，
# 否则任何人都能伪造该头绕过限速与 IP 配额。直连部署留空即可。
# 例：TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# ---- 防洪（Flash Flood）----
# 单 IP 每分钟跳转上限，超出返回友好 429 页；0 表示关闭
GUARD_IP_PER_MINUTE=120
# 单 IP 每日点击配额；0 表示关闭
GUARD_IP_DAILY=20000
# 单个短码每分钟点击上限；0 表示关闭（热链接被打爆时先牺牲它，保站点存活）
GUARD_CODE_PER_MINUTE=0
# 命中限流后封禁时长（秒）
GUARD_BLOCK_SECONDS=60
# UA 黑名单，逗号分隔，支持子串与 * 通配；命中仍跳转但不计数
BLOCKED_UAS=
BLOCKED_UA_ENABLED=true

# ---- 微信 / QQ 内打开 ----
# warn：放行并在中转页提示复制到浏览器（默认）；blocked：一律拦截；off：不处理
WECHAT_MODE=warn
QQ_MODE=warn

# ---- 点击计数 ----
# 点击先入内存缓冲，按此间隔批量落库
CLICK_FLUSH_INTERVAL=5
# 攒够这么多条立即结算
CLICK_FLUSH_BATCH=200
