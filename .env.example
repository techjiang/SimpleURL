# 站点名称
SITE_NAME=SimpleURL

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 调试模式（开启后开放 /api/docs）
DEBUG=false

# 短码长度
CODE_LENGTH=6
CODE_MIN_LENGTH=3
CODE_MAX_LENGTH=16

# 单 IP 每日创建上限，0 表示不限制
CREATE_DAILY_LIMIT=200

# 数据库连接，默认 SQLite；Postgres 示例：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/simpleurl

# 管理令牌（预留）
ADMIN_TOKEN=

# 访问令牌：设置后访问短链与统计页需带 ?token=xxx（留空表示公开）
ACCESS_TOKEN=

# 单次导出 CSV 的最大条数
EXPORT_MAX_ROWS=50000

# ---------- 延迟计数 ----------
# 点击缓冲多久批量落库一次（秒）
CLICK_FLUSH_INTERVAL=5

# ---------- 防洪 ----------
# 单 IP 每分钟跳转上限，0 不限制
REDIRECT_RATE_LIMIT=120
# 单 IP 每日点击上限，0 不限制
CLICK_DAILY_LIMIT=0

# ---------- 标题 / 密钥 / YOURLS ----------
# 创建时自动获取目标页标题
FETCH_TITLE=true
# 要求 API 请求携带 X-Api-Key
REQUIRE_API_KEY=false
# YOURLS 兼容接口签名（留空则不校验）
YOURLS_TOKEN=
