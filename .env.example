# 站点名称
SITE_NAME=SimpleURL

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 调试模式（开启后开放 /api/docs）
DEBUG=false

# 短码长度（自动生成，后台「设置」里也能改）
CODE_LENGTH=4
CODE_MIN_LENGTH=3
CODE_MAX_LENGTH=16
# 随机码是否排除易混字符 0 O 1 l I；自定义短码不受影响
CODE_NO_AMBIGUOUS=true

# 单 IP 每日创建上限，0 表示不限制
CREATE_DAILY_LIMIT=200
# 首页公开热门榜条数（3~20），0 关闭。只展示短码与点击数，不含目标地址
BOARD_SIZE=5

# 数据库连接，默认 SQLite；Postgres 示例：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/simpleurl

# 管理员账号密码：登录页用它登录，安装脚本会自动生成并写进这里。
# 密码也支持直接填 app.core.crypto 产出的哈希值（$argon2id$... / pbkdf2_sha256$...），
# 后台「设置 → 管理员账号」改完会自动写回本文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 管理令牌（兼容入口）：脚本 / CI 用 X-Admin-Token 头登录时认它，格式 admin:password
# 可分开设账号；与上面的账号密码任一命中即可登录。
ADMIN_TOKEN=

# 站点对外地址：配了它，短链、二维码、复制出来的地址都用这个域名。
# 挂在 Nginx / Caddy / Cloudflare 后面必填，否则拼出来是 127.0.0.1:8000——
# 请求里的 Host 是内网地址，别人打不开。后台「站点设置」里也能改。
# 例：PUBLIC_URL=https://s.example.com
PUBLIC_URL=

# 访问令牌：设置后访问短链与统计页需带 ?token=xxx（留空表示公开）
ACCESS_TOKEN=

# 会话签名密钥：不设则复用管理凭据（ADMIN_TOKEN / ADMIN_PASSWORD），
# 建议单独配置以便独立轮换（换了等于全站重新登录）
SECRET_KEY=

# 信任哪些反向代理的 X-Forwarded-For / X-Real-IP，逗号分隔或网段。
# 默认只信任回环；填 * 表示无条件信任（仅限内网全可信环境）
TRUSTED_PROXIES=127.0.0.1,::1

# 后台登录防爆破：单 IP 5 分钟内最多尝试次数，0 不限制
LOGIN_RATE_LIMIT=10

# 后台口令长度下限，启动时低于该值会打警告
MIN_ADMIN_TOKEN_LENGTH=12

# 单次导出 CSV 的最大条数
EXPORT_MAX_ROWS=50000

# 创建短链时是否解析域名核对内网（SSRF）。关掉只校验字面 IP，
# 适合离线部署或 DNS 不可信的环境；开着更安全，是默认值
SSRF_RESOLVE_CHECK=true
# 解析结果缓存秒数。不宜长：DNS 重绑定靠的就是「第一次解析是公网」
DNS_CACHE_TTL=60
# 单次域名解析的硬超时（秒）。getaddrinfo 是同步阻塞的，域名服务器不回话时
# 会按系统解析器的默认值（5 秒 × 重试）卡住整条创建链路，所以这里自己掐表。
# 超时按「解析不出来」处理 = 拒收，宁可误伤也不把内网当公网放过去
DNS_TIMEOUT=2

# ---------- 延迟计数 ----------
# 点击缓冲多久批量落库一次（秒）
CLICK_FLUSH_INTERVAL=5
# 缓冲队列上限：数据库写入卡住时，内存不能跟着请求数一起涨。超限丢弃最旧的
CLICK_BUFFER_MAX=20000
# 点击明细保留天数（只删明细，累计点击数不动），0 表示不清理
CLICK_EVENT_RETENTION_DAYS=365

# ---------- 站点展示 ----------
# 首页顶部公告，留空则不显示（后台「设置 → 站点公告」也可改）
ANNOUNCEMENT=
# 页脚那句自述
SITE_TAGLINE=数据可自托管，隐私尽在掌握

# ---------- 防洪 ----------
# 单 IP 每分钟跳转上限，0 不限制
REDIRECT_RATE_LIMIT=120
# 单 IP 每日点击上限（按自然日重置），0 不限制
CLICK_DAILY_LIMIT=0

# ---------- 标题 / 密钥 / YOURLS ----------
# 创建时自动获取目标页标题
FETCH_TITLE=true
# 要求 API 请求携带 X-Api-Key
REQUIRE_API_KEY=false
# YOURLS 兼容接口签名（留空则不校验）
YOURLS_TOKEN=

# ---------- 社交平台防洪 ----------
# 总开关。平台策略与拦截页提示语都在后台「防洪 / UA 屏蔽」里改，落库生效，
# 这里只给默认值。
SOCIAL_GUARD=true
# 拦截页提示语
SOCIAL_BLOCK_HINT=该链接暂时无法在此处打开，请点击右上角选择「在浏览器中打开」，或复制链接后重试。
# 微信 / QQ 来源打标记（照常放行并计数），关掉则不再区分来源平台
SOCIAL_TAG_WECHAT=true
SOCIAL_TAG_QQ=true

# ---------- 回执找回 ----------
# 丢了回执的访客可以凭「线索」（邮箱 / 自述）重签一张。关掉则入口消失
CLAIM_LOOKUP=true

# ---------- 时区 ----------
# 过期时间、统计按天分桶、「今天」的口径都跟着它走。
# 容器默认是 UTC，国内部署建议显式设置，否则早上 7 点前的点击会被算到前一天
TZ=Asia/Shanghai

# ---------- 通知通道 ----------
# 部署自检、配额告警出现时自动推一条（后台「通知」页也能开）
NOTIFY_ENABLED=false
# 同类告警静默时长（秒），默认 1 小时；后台「通知」页可改，0 表示每次都发
NOTIFY_COOLDOWN=3600

# Webhook：接收 JSON POST，{title, text, level, site, time}
NOTIFY_WEBHOOK_URL=
# 可选。填了会在请求头带 X-SimpleURL-Secret，方便对端验身
NOTIFY_WEBHOOK_SECRET=

# 邮件：465 端口用 NOTIFY_EMAIL_STARTTLS=0（SSL），587 保持 1（STARTTLS）
NOTIFY_EMAIL_HOST=
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_STARTTLS=1
NOTIFY_EMAIL_FROM=

# Bark（iOS 推送）：https://api.day.app/你的Key
NOTIFY_BARK_URL=
